{
  "name": "ottisk",
  "version": "1.1.0",
  "private": true,
  "description": "ОТТИСК — существо живёт только под пальцем",
  "scripts": {
    "start": "npx --yes serve -l 8765 .",
    "serve": "npx --yes serve -l 8765 .",
    "build:www": "node scripts/build-www.mjs",
    "cap:sync": "npm run build:www && npx cap sync",
    "cap:ios": "npm run build:www && npx cap open ios",
    "postinstall": "node scripts/build-www.mjs"
  },
  "dependencies": {
    "@capacitor/app": "^7.0.2",
    "@capacitor/core": "^7.4.2",
    "@capacitor/haptics": "^7.0.2",
    "@capacitor/ios": "^7.4.2",
    "@capacitor/share": "^7.0.2",
    "@capacitor/splash-screen": "^7.0.2",
    "@capacitor/status-bar": "^7.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.2"
  }
}
